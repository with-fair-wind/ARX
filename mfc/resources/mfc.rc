#pragma code_page(65001)
#include <Resources/mfc_rc.h>
#include "afxres.h"

IDD_MFC_TEST DIALOGEX 0, 0, 220, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MFC测试对话框"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "这是一个MFC对话框示例！\r\n基于ARX二次开发", IDC_STATIC, 10, 10, 200, 30, SS_CENTER
    DEFPUSHBUTTON "确定", IDOK, 85, 80, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 140, 80, 50, 14
END

IDD_MFC_ARX_UI DIALOGEX 0, 0, 240, 140
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ARX UI 对话框"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "这是一个基于 CZcUiDialog 的 ARX UI 示例", IDC_STATIC, 10, 10, 220, 14, SS_LEFT
    LTEXT "输入文本:", IDC_STATIC, 10, 32, 50, 12
    EDITTEXT IDC_ARXUI_EDIT_INPUT, 70, 30, 150, 14, ES_AUTOHSCROLL
    CONTROL "在命令行打印", IDC_ARXUI_CHECK_CMD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 70, 50, 90, 12
    PUSHBUTTON "显示内容", IDC_ARXUI_BTN_SHOW, 70, 72, 60, 14
    DEFPUSHBUTTON "确定", IDOK, 140, 72, 40, 14
    PUSHBUTTON "取消", IDCANCEL, 185, 72, 40, 14
END

IDD_MFC_LOAD_TO_DOC DIALOGEX 0, 0, 280, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "载入至文档"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "选择需要载入的文档", IDC_STATIC, 10, 10, 200, 12
    CONTROL "", IDC_LOAD_DOC_LIST, "SysListView32", LVS_REPORT | WS_BORDER | WS_TABSTOP, 10, 26, 260, 100
    CONTROL "载入后布置构件", IDC_LOAD_AFTER_PLACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 136, 120, 12
    CONTROL "载入后关闭构件", IDC_LOAD_AFTER_CLOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 154, 120, 12
    DEFPUSHBUTTON "确认", IDOK, 160, 172, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 220, 172, 50, 14
END

IDD_MFC_RENAME_COMPONENT DIALOGEX 0, 0, 245, 116
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "中望BIM"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON "", IDC_RENAME_ICON, 12, 22, 20, 20
    LTEXT "本文档内存在同名构件，请重置名称再载入", IDC_RENAME_MSG, 40, 16, 188, 20
    LTEXT "原名称", IDC_STATIC, 40, 42, 40, 12
    EDITTEXT IDC_RENAME_EDIT_ORIGINAL, 84, 40, 140, 14, ES_AUTOHSCROLL | ES_READONLY
    LTEXT "现名称", IDC_STATIC, 40, 64, 40, 12
    EDITTEXT IDC_RENAME_EDIT_NEW, 84, 62, 140, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "确定", IDOK, 145, 92, 42, 14
    PUSHBUTTON "取消载入", IDC_RENAME_BTN_CANCEL_LOAD, 191, 92, 50, 14
END

IDD_MFC_OVERWRITE_CONFIRM DIALOGEX 0, 0, 284, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "中望BIM"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON "", IDC_OVERWRITE_ICON, 16, 21, 20, 20
    LTEXT "当前文档已存在本构件，是否覆盖更新当前构件和参数值", IDC_OVERWRITE_MSG, 44, 24, 230, 12, SS_LEFTNOWORDWRAP
    CONTROL "", IDC_STATIC, "Static", SS_GRAYRECT, 0, 58, 284, 27
    DEFPUSHBUTTON "全部更新", IDC_OVERWRITE_BTN_ALL, 134, 64, 42, 14
    PUSHBUTTON "不覆盖参数值", IDC_OVERWRITE_BTN_NO_PARAM, 180, 64, 52, 14
    PUSHBUTTON "取消载入", IDC_OVERWRITE_BTN_CANCEL, 236, 64, 42, 14
END

IDD_MFC_COMPONENT_BROWSER DIALOGEX 0, 0, 200, 340
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
CAPTION "构件浏览器"
FONT 9, "MS Shell Dlg"
BEGIN
    EDITTEXT IDC_CB_SEARCH_EDIT, 4, 4, 150, 14, ES_AUTOHSCROLL
    PUSHBUTTON "👁", IDC_CB_BTN_TOGGLE_VISIBILITY, 158, 4, 16, 14
    PUSHBUTTON "📥", IDC_CB_BTN_LOAD, 176, 4, 16, 14
    CONTROL "", IDC_CB_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 22, 192, 290
    PUSHBUTTON "布置", IDC_CB_BTN_PLACE, 4, 318, 40, 16
END

IDD_MFC_PROPERTY_PERMISSION DIALOGEX 0, 0, 270, 206
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "属性权限设置"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "设置属性是否可编辑", IDC_STATIC, 10, 10, 130, 12
    CONTROL "可编辑", IDC_PROPERTY_PERMISSION_MASTER, "Button", BS_3STATE | WS_TABSTOP, 215, 10, 45, 12
    CONTROL "", IDC_PROPERTY_PERMISSION_LIST, "SysListView32", LVS_REPORT | WS_BORDER | WS_TABSTOP, 10, 26, 250, 150
    DEFPUSHBUTTON "确认", IDOK, 150, 184, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 210, 184, 50, 14
END

IDD_MFC_NEW_FAMILY DIALOGEX 0, 0, 245, 108
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新建族"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "类别名称", IDC_STATIC, 10, 12, 44, 12
    COMBOBOX IDC_NEW_FAMILY_CATEGORY_COMBO, 60, 10, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "样板文件", IDC_STATIC, 10, 38, 44, 12
    EDITTEXT IDC_NEW_FAMILY_TEMPLATE_EDIT, 60, 36, 122, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_NEW_FAMILY_TEMPLATE_BROWSE, 186, 36, 16, 14
    LTEXT "族名称", IDC_STATIC, 10, 64, 44, 12
    EDITTEXT IDC_NEW_FAMILY_NAME_EDIT, 60, 62, 140, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "确定", IDOK, 128, 88, 36, 14
    PUSHBUTTON "取消", IDCANCEL, 168, 88, 36, 14
END