Diagnostics:
  ClangTidy:
    Add: ["*"]
    Remove:
      [
        abseil*,
        fuchsia*,
        llvmlib*,
        zircon*,
        altera*,
        google-readability-todo,
        readability-braces-around-statements,
        hicpp-braces-around-statements,
        modernize-use-trailing-return-type,
      ]
Index:
  Background: Build
CompileFlags:
  Add: [--driver-mode=cl]
  Remove:
    - /Fo*
    # - /Fd*
    # - /Fp*
    # - /Yu*
    # - /Yc*
    # - /FI*
    # - /MP
    # - /nologo
